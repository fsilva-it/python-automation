# Copie para .env e preencha. Carregue no shell antes de rodar:
#   set -a; source .env; set +a
# NUNCA comite o .env preenchido (ja esta coberto pelo .gitignore do repo).

# --- Alvo e estrategia ---
WAQA_PROVIDER=cloud
WAQA_TARGET_NUMBER=552133861504        # numero do bot sob teste (E.164, so digitos)
WAQA_GRADER=ai                         # ai | keyword | exact | hybrid
WAQA_REPLY_TIMEOUT=30                   # espera maxima (s) por resposta de cada caso
WAQA_PAUSE_BETWEEN=3                    # pausa (s) entre casos (respeita rate limit)

# --- WhatsApp Cloud API (Meta) ---
WAQA_CLOUD_PHONE_NUMBER_ID=            # ID do numero REMETENTE (o numero do harness, nao o do bot)
WAQA_CLOUD_ACCESS_TOKEN=              # token de acesso (System User token de longa duracao, de preferencia)
WAQA_CLOUD_API_VERSION=v21.0

# --- Avaliacao por IA (Claude) ---
ANTHROPIC_API_KEY=                    # a mesma chave ja usada no chama-project
WAQA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Provider generico (gateway/BSP proprio: Evolution, Z-API, WPPConnect, etc.) ---
# Use quando WAQA_PROVIDER=generic. Escolha um preset e sobreponha URL/token.
# Rode 'python -m whatsapp_qa presets' para ver todos. Ver docs/REUNIAO-PROVEDOR.md.
# WAQA_PROVIDER=generic
# WAQA_GENERIC_PRESET=evolution        # evolution | wppconnect | zapi | cloud | 360dialog | twilio | gupshup | zenvia
# WAQA_GENERIC_SEND_URL=https://SEU-SERVIDOR/message/sendText/SUA-INSTANCIA
# WAQA_GENERIC_AUTH_TOKEN=             # token/api-key (ver a nota do preset)
# Sobrescreva qualquer campo do preset, se necessario:
# WAQA_GENERIC_METHOD=POST
# WAQA_GENERIC_CONTENT_TYPE=json       # json | form
# WAQA_GENERIC_AUTH_TYPE=header        # bearer | header | query | basic | path | none
# WAQA_GENERIC_AUTH_HEADER=apikey
# WAQA_GENERIC_HEADERS={"Client-Token":"..."}   # headers estaticos extras (JSON)
# WAQA_GENERIC_BODY_TEMPLATE={"number":"{{to}}","text":"{{body}}"}
# WAQA_GENERIC_MSG_ID_PATH=key.id
# WAQA_GENERIC_INBOUND_TEXT_PATH=data.message.conversation
# WAQA_GENERIC_INBOUND_FROM_PATH=data.key.remoteJid
# WAQA_GENERIC_INBOUND_FROMME_PATH=data.key.fromMe

# --- Webhook / inbox ---
WAQA_INBOX_PATH=whatsapp_qa_inbox.jsonl
